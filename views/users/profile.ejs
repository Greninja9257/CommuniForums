<%- include('../layout', { body: `
<div class="pf-hero">
  <div class="pf-banner"></div>
  <div class="pf-card">
    <div class="pf-identity">
      <img src="${profileUser.avatar}" alt="" class="pf-avatar" onerror="this.src='/css/default-avatar.svg'">
      <div class="pf-name-row">
        <h1 class="pf-username">${profileUser.username}</h1>
        ${profileUser.role !== 'user' ? `<span class="role-badge role-${profileUser.role}">${profileUser.role}</span>` : ''}
      </div>
      <span class="pf-rank-pill" style="color: ${rank.color}">${rank.title}</span>
      ${profileUser.bio ? `<p class="pf-bio">${profileUser.bio}</p>` : ''}
      <div class="pf-meta">
        <span>Joined ${formatDate(profileUser.created_at)}</span>
        <span class="pf-dot">&middot;</span>
        <span>Active ${formatDate(profileUser.last_active)}</span>
      </div>
    </div>
    <div class="pf-stats-strip">
      <div class="pf-stat">
        <span class="pf-stat-num">${profileUser.thanks_received}</span>
        <span class="pf-stat-label">Thanks Received</span>
      </div>
      <div class="pf-stat">
        <span class="pf-stat-num">${profileUser.thanks_given}</span>
        <span class="pf-stat-label">Thanks Given</span>
      </div>
      <div class="pf-stat">
        <span class="pf-stat-num">${profileUser.post_count}</span>
        <span class="pf-stat-label">Posts</span>
      </div>
      <div class="pf-stat">
        <span class="pf-stat-num">${profileUser.thread_count}</span>
        <span class="pf-stat-label">Threads</span>
      </div>
    </div>
  </div>
</div>

<div class="pf-body">
  <div class="pf-main">

    <div class="section-card">
      <h2 class="pf-section-title">Recent Posts</h2>
      ${recentPosts.length === 0 ? '<p class="empty-state">No posts yet.</p>' : `
        <div class="pf-feed">
          ${recentPosts.map(p => `
            <a href="/forums/thread/${p.thread_id}#post-${p.id}" class="pf-feed-item">
              <div class="pf-feed-thread">${p.thread_title}</div>
              <div class="pf-feed-preview">${truncate(p.content, 160)}</div>
              <div class="pf-feed-time">${formatDate(p.created_at)}</div>
            </a>
          `).join('')}
        </div>
      `}
    </div>

    <div class="section-card">
      <h2 class="pf-section-title">Recent Threads</h2>
      ${recentThreads.length === 0 ? '<p class="empty-state">No threads yet.</p>' : `
        <div class="pf-feed">
          ${recentThreads.map(t => `
            <a href="/forums/thread/${t.id}" class="pf-feed-item">
              <div class="pf-feed-thread">${t.title}</div>
              <div class="pf-feed-meta">in ${t.category_name} &middot; ${formatDate(t.created_at)}</div>
            </a>
          `).join('')}
        </div>
      `}
    </div>

  </div>
  <div class="pf-sidebar">

    <div class="section-card">
      <h3 class="pf-sidebar-title">Rank Progress</h3>
      <div class="pf-rank-now" style="color: ${rank.color}">${rank.title}</div>
      <div class="pf-rank-bar-wrap">
        <div class="pf-rank-bar-fill" style="width: ${rankProgress.progressPercent}%; background: ${rank.color}"></div>
      </div>
      <div class="pf-rank-detail">
        ${rankProgress.currentThanks} / ${rankProgress.requiredThanks} thanks
        ${rankProgress.nextRankTitle ? `<span class="pf-rank-next">→ ${rankProgress.nextRankTitle}</span>` : '<span class="pf-rank-max">Max rank reached</span>'}
      </div>
    </div>

    <div class="section-card">
      <h3 class="pf-sidebar-title">Badges <span class="pf-count">${badges.length}</span></h3>
      ${badges.length === 0 ? '<p class="empty-state">No badges yet.</p>' : `
        <div class="pf-badge-grid">
          ${badges.map(b => `
            <div class="pf-badge-item" title="${b.description}">
              <span class="pf-badge-icon">${b.icon}</span>
              <span class="pf-badge-name">${b.name}</span>
            </div>
          `).join('')}
        </div>
      `}
    </div>

    <div class="section-card">
      <h3 class="pf-sidebar-title">Stats</h3>
      <div class="pf-info-grid">
        <div class="pf-info-item">
          <span class="pf-info-val">${trustLevel.toUpperCase()}</span>
          <span class="pf-info-key">Trust Level</span>
        </div>
        <div class="pf-info-item">
          <span class="pf-info-val">${trustScore}</span>
          <span class="pf-info-key">Trust Score</span>
        </div>
        <div class="pf-info-item">
          <span class="pf-info-val">${postsRecent}</span>
          <span class="pf-info-key">Posts (30d)</span>
        </div>
        <div class="pf-info-item">
          <span class="pf-info-val">${thanksGivenRecent}</span>
          <span class="pf-info-key">Thanks (30d)</span>
        </div>
      </div>
    </div>

    ${profileUser.rank_override_title ? `
      <div class="section-card">
        <h3 class="pf-sidebar-title">Special Rank</h3>
        <p class="pf-special-rank">${profileUser.rank_override_title}</p>
        ${profileUser.rank_override_reason ? `<p class="pf-muted">Reason: ${profileUser.rank_override_reason}</p>` : ''}
        ${rankOverrideBy ? `<p class="pf-muted">Granted by <a href="/users/profile/${rankOverrideBy.id}">${rankOverrideBy.username}</a></p>` : ''}
      </div>
    ` : ''}

    ${canManageRanks ? `
      <div class="section-card">
        <h3 class="pf-sidebar-title">Rank Management</h3>
        <form method="POST" action="/users/profile/${profileUser.id}/rank" class="settings-form">
          <div class="form-group">
            <label>Assign Rank</label>
            <select name="rank_title" required>
              ${rankOptions.map(r => `
                <option value="${r}" ${profileUser.rank_override_title === r ? 'selected' : ''}>${r}</option>
              `).join('')}
            </select>
          </div>
          <div class="form-group">
            <label>Reason (optional)</label>
            <input type="text" name="reason" placeholder="Why this rank is granted">
          </div>
          <button type="submit" class="btn btn-primary btn-block">Save Rank</button>
        </form>
        ${profileUser.rank_override_title ? `
          <form method="POST" action="/users/profile/${profileUser.id}/rank" class="settings-form mt-2">
            <input type="hidden" name="action" value="clear">
            <button type="submit" class="btn btn-danger btn-block">Revoke Override</button>
          </form>
        ` : ''}
      </div>
    ` : ''}

  </div>
</div>
` }) %>
